@startuml MasjidWala_TV_Architecture

' ============================================================
' MasjidWala TV — Component Architecture Diagram
' Render with: https://www.plantuml.com/plantuml/uml/
' ============================================================

skinparam componentStyle rectangle
skinparam backgroundColor #FAFAFA
skinparam component {
    BackgroundColor #EAF4FB
    BorderColor #2E86C1
    FontColor #1A252F
}
skinparam package {
    BackgroundColor #F9F9F9
    BorderColor #AAB7B8
}
skinparam arrow {
    Color #2C3E50
    FontColor #5D6D7E
    FontSize 11
}
skinparam title {
    FontSize 16
    FontColor #1A252F
}

title MasjidWala TV — System Component Architecture

' ============================================================
' EXTERNAL SYSTEMS
' ============================================================
cloud "MasjidWala Backend API" as API {
    [/sync]
    [/screen_settings]
    [/calendar]
    [/slideshow]
    [/translation]
    [/login + /otp]
}

' ============================================================
' ANDROID OS LAYER
' ============================================================
package "Android OS" {
    [BootReceiver\n<<BroadcastReceiver>>] as BootReceiver
    [AppStartService\n<<ForegroundService>>] as AppStartService
}

' ============================================================
' PRESENTATION LAYER
' ============================================================
package "Presentation Layer" {
    [LoginActivity] as LoginActivity
    [MainActivity] as MainActivity
    [MainUI\n<<Singleton>>] as MainUI
    [CarouselAdapter\n<<RecyclerView.Adapter>>] as CarouselAdapter
    [ProgressBarHandler] as ProgressBarHandler
}

' ============================================================
' ORCHESTRATION
' ============================================================
package "Orchestration" {
    [GenFunc\n(Sync + Time Utils)] as GenFunc
}

' ============================================================
' DOMAIN LAYER
' ============================================================
package "Domain Layer" {
    [Settings] as Settings
    [PerpetualCalendar] as PerpetualCalendar
    [Prayer] as Prayer
    [DisplayObject] as DisplayObject
    [Slides] as Slides
    [Translations] as Translations
}

' ============================================================
' DATA LAYER
' ============================================================
package "Data Layer" {
    [DbFunc\n(CRUD Operations)] as DbFunc
    [VolleySingleton\n(HTTP Queue)] as VolleySingleton
    [AuthPreferences\n(SharedPreferences)] as AuthPreferences
}

' ============================================================
' PERSISTENCE
' ============================================================
database "SQLite\n(masjid.wala)" as SQLite {
    [TABLE: settings]
    [TABLE: namaz_times]
    [TABLE: slides]
}

' ============================================================
' RELATIONSHIPS — Boot Flow
' ============================================================
BootReceiver --> AppStartService : starts (on BOOT_COMPLETED)
AppStartService --> LoginActivity : launches (after 5s delay)

' ============================================================
' RELATIONSHIPS — Auth Flow
' ============================================================
LoginActivity --> VolleySingleton : OTP / Login requests
VolleySingleton --> API : HTTP (NO_AUTH / BASIC_AUTH)
LoginActivity --> AuthPreferences : savePreference(token, masjidId)
LoginActivity --> MainActivity : startActivity() on success

' ============================================================
' RELATIONSHIPS — Sync Flow
' ============================================================
MainActivity --> GenFunc : syncRequest()
GenFunc --> VolleySingleton : addToRequestQueue()
VolleySingleton --> API : HTTP (BEARER_TOKEN)
API --> VolleySingleton : JSON Response
GenFunc --> DbFunc : insertSettings / insertPrayerTimes / insertSlides
GenFunc --> AuthPreferences : saveTranslationPreference()
DbFunc --> SQLite : SQL read/write

' ============================================================
' RELATIONSHIPS — UI Flow
' ============================================================
MainActivity --> MainUI : init(context)
MainUI --> DbFunc : getSettings() / getPerpetualCalendar()
MainUI --> GenFunc : time utility calls
MainUI --> DisplayObject : builds List<DisplayObject>
DisplayObject --> Prayer : contains (nullable)
MainUI --> MainActivity : updateTextViews()
MainActivity --> CarouselAdapter : submitList(slides)
CarouselAdapter --> DbFunc : getSlides()
CarouselAdapter --> Slides : renders BLOB as Bitmap
MainActivity --> ProgressBarHandler : startProgressBar(duration)

' ============================================================
' RELATIONSHIPS — Domain → Data
' ============================================================
DbFunc --> Settings : returns
DbFunc --> PerpetualCalendar : returns
DbFunc --> Slides : returns
AuthPreferences --> Translations : returns (serialised JSON)
GenFunc --> Translations : parses + constructs

' ============================================================
' NOTES
' ============================================================
note right of GenFunc
  All network calls are suspend functions
  executed in Dispatchers.IO coroutine scope.
  UI updates posted to Looper.getMainLooper().
end note

note right of MainUI
  Singleton pattern (double-checked locking).
  Destroyed and re-initialised on each sync
  cycle to reflect fresh data.
end note

note bottom of SQLite
  Single-row pattern for settings table.
  Full replace on slides sync.
  Upsert-by-date for namaz_times.
end note

@enduml
